<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JYTPartner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The launch splash — navy background with the J mark, dismissed by
         installSplashScreen() once the session restore resolves. -->
    <style name="Theme.JYTPartner.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JYTPartner</item>
    </style>
</resources>
