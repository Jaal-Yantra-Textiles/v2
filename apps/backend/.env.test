# 🔴 DO NOT put DB_POOL_MIN/DB_POOL_MAX here. This file is TRACKED and
# reaches CI, where the integration shards get whatever is written below and
# nothing else. A laptop-sized DB_POOL_MAX=1 turned all 8 shards red with
# "Knex: Timeout acquiring a connection" (run 35706135474).
#
# A local cap belongs in apps/backend/.env, which is gitignored and which
# Medusa's loadEnv reads alongside this file in test mode (.env.test wins on
# any key it defines). Unset, the knob in medusa-config.ts is inert.

MEDUSA_FF_INDEX_ENGINE=true

# Encryption Service (required by the encryption module in tests)
ENCRYPTION_KEY=JufJT6sFg0p2hzk5ivGUj/dMd8c9jFdVU7D5Yc7lS64=
ENCRYPTION_KEY_VERSION=1

# Short timeout for lifecycle workflow async steps in tests
# so waitWorkflowExecutions doesn't hang (prod default is 23 days)
PRODUCTION_RUN_AWAIT_TIMEOUT_SECONDS=5

# Disable Mastra AI connections in tests
MASTRA_DISABLED=true

# Disable partner email verification in tests — test partners are
# created programmatically and can't receive verification emails.
PARTNER_EMAIL_VERIFICATION=false

# WhatsApp integration test (Meta Cloud API)
