test-results/
apps/backend/test-results/

# Hyperbee/autobase stores the backend writes on startup. Created at runtime,
# per-machine, never source — they showed up as untracked noise in every
# `git status` and are one careless `git add -A` away from being committed.
apps/backend/_crm_hb_e2e/
apps/backend/_pp_hb_e2e/

# Local AI agent memory — never commit
.ai-memory/


# Backlog-audit inputs only. Verdicts stay VISIBLE to git so delegate.mjs can
# see what the drafter wrote — its scope gate reads `git status`, which skips
# ignored paths. Neither dir is ever committed.
.audit/issues/

# Delegate run transcripts and per-run results — noise, not history.
scripts/agent-daemon/delegate-logs/

# 🔴 Vendor credentials, endpoints and correspondence. This repo is PUBLIC.
.audit/private/

# Wave sentinels — process state, written so a chained batch can wait on a FILE
# rather than on `pgrep`, which matches the waiter's own command line and hangs.
.audit/batches/
